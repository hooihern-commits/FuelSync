PORT=3000
DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here

# Set to false for a local or CI Postgres without TLS. Hosted (Neon) needs true.
DATABASE_SSL=true
# Max connections this server opens to Postgres.
DATABASE_POOL_MAX=10

# ML nutrition service (ml_nutrition/). Suggestions fall back to the rule
# engine if it is unreachable.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=2500

# Rate limits, per client IP.
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=30
RATE_LIMIT_SYNC_PER_MIN=60
# Number of proxies in front of the server (1 on Railway or Render, 0 locally).
TRUST_PROXY=1
